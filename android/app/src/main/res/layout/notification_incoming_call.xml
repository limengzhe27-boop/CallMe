<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/incoming_avatar"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/notification_avatar_background"
        android:clipToOutline="true"
        android:contentDescription=""
        android:scaleType="centerCrop"
        android:src="@drawable/ic_caller_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/incoming_caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="联系人"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/incoming_call_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="邀请你语音通话."
            android:textColor="#A8FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/incoming_decline"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/notification_decline_background"
        android:contentDescription="拒绝"
        android:padding="12dp"
        android:src="@drawable/ic_phone_down_white" />

    <ImageButton
        android:id="@+id/incoming_answer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/notification_answer_background"
        android:contentDescription="接听"
        android:padding="12dp"
        android:src="@drawable/ic_phone_white" />
</LinearLayout>
